  <style>
    :root {
      --primary: #1E3A8A;
      --primary-dark: #1E40AF;
      --secondary: #059669;
      --accent: #F59E0B;
      --light: #F9FAFB;
      --gray: #64748B;
      --text: #1F2937;
      --card-bg: white;
      --shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
      --transition: all 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', sans-serif;
      color: var(--text);
      background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
      line-height: 1.6;
    }

    .container {
      width: min(95%, 1400px);
      margin: 0 auto;
      padding: 0 20px;
    }

    /* Header */
    header {
      background: white;
      box-shadow: 0 2px 15px rgba(0,0,0,0.06);
      padding: 16px 0;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .header-content {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-family: 'Poppins', sans-serif;
      font-size: 1.7rem;
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* Hero */
    #hero {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
      color: white;
      padding: 80px 0 50px;
      text-align: center;
    }

    .hero-content h1 {
      font-family: 'Poppins', sans-serif;
      font-size: clamp(2rem, 6vw, 3.4rem);
      font-weight: 800;
      margin-bottom: 12px;
    }

    /* Search & Filters */
    .search-section {
      background: white;
      padding: 24px;
      border-radius: 16px;
      margin: -30px auto 40px;
      max-width: 1200px;
      box-shadow: var(--shadow);
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      align-items: center;
    }

    .search-box {
      display: flex;
      gap: 12px;
      flex: 1;
      min-width: 300px;
    }

    .search-box input,
    .search-box select,
    .search-box button {
      padding: 12px 20px;
      border-radius: 10px;
      font-size: 1rem;
      border: 1px solid #D1D5DB;
      outline: none;
    }

    .search-box input { flex: 1; }
    .search-box button {
      background: var(--primary);
      color: white;
      border: none;
      cursor: pointer;
      font-weight: 600;
    }

    .filter-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .filter-btn {
      padding: 8px 16px;
      background: #F1F5F9;
      border: none;
      border-radius: 8px;
      font-size: 0.9rem;
      cursor: pointer;
      transition: var(--transition);
    }

    .filter-btn:hover,
    .filter-btn.active {
      background: var(--primary);
      color: white;
    }

    /* Categories Nav */
    .categories-nav {
      display: flex;
      justify-content: center;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 40px;
    }

    .cat-btn {
      padding: 10px 20px;
      background: white;
      border: 1px solid #E2E8F0;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
      transition: var(--transition);
    }

    .cat-btn:hover,
    .cat-btn.active {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
    }

    /* Signs Grid */
    #signs-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 24px;
      padding-bottom: 60px;
    }

    .sign-card {
      background: white;
      border-radius: 16px;
      padding: 24px 20px;
      text-align: center;
      box-shadow: var(--shadow);
      transition: var(--transition);
      position: relative;
    }

    .sign-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 12px 20px -5px rgba(30, 58, 138, 0.15);
    }

    .sign-image {
      width: 140px;
      height: 140px;
      margin: 0 auto 16px;
      background: #F8FAFC;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 4.5rem;
      color: var(--primary);
    }

    .sign-card h3 {
      font-size: 1.15rem;
      font-weight: 700;
      margin-bottom: 8px;
      color: var(--primary);
    }

    .sign-code {
      font-size: 0.85rem;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 10px;
    }

    .sign-desc {
      font-size: 0.9rem;
      color: var(--gray);
      line-height: 1.5;
    }

    /* No results */
    #no-results {
      grid-column: 1 / -1;
      text-align: center;
      padding: 60px 20px;
      color: var(--gray);
      display: none;
    }

    /* Footer */
    footer {
      background: var(--primary);
      color: rgba(255,255,255,0.8);
      padding: 30px 0;
      text-align: center;
      font-size: 0.95rem;
    }

    @media (max-width: 600px) {
      .search-section { flex-direction: column; }
      .filter-group { width: 100%; }
    }
  </style>
</head>
