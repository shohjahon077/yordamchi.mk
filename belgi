  <script>
    // GSAP animatsiya
    gsap.registerPlugin(ScrollTrigger);

    window.addEventListener('load', () => {
      // Hero sarlavha
      const heroTitle = new SplitType('#hero-title', { types: 'words' });
      gsap.from(heroTitle.words, {
        y: 40,
        opacity: 0,
        stagger: 0.05,
        duration: 1,
        ease: 'power3.out'
      });

      // Belgilar kirib kelishi
      gsap.utils.toArray('.sign-card').forEach((card, i) => {
        gsap.from(card, {
          y: 60,
          opacity: 0,
          scale: 0.95,
          duration: 0.7,
          delay: i * 0.05,
          ease: 'power3.out',
          scrollTrigger: {
            trigger: card,
            start: 'top 95%',
            once: true
          }
        });
      });
    });

    // === Qidiruv va filtr ===
    const searchInput = document.getElementById('search-input');
    const searchBtn = document.getElementById('search-btn');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const catBtns = document.querySelectorAll('.cat-btn');
    const signs = document.querySelectorAll('.sign-card');
    const noResults = document.getElementById('no-results');

    function filterSigns() {
      const query = searchInput.value.toLowerCase().trim();
      const activeFilter = document.querySelector('.filter-btn.active')?.getAttribute('data-filter');
      const activeCat = document.querySelector('.cat-btn.active')?.getAttribute('data-cat');

      let count = 0;

      signs.forEach(sign => {
        const name = sign.getAttribute('data-name').toLowerCase();
        const code = sign.getAttribute('data-code').toLowerCase();
        const type = sign.getAttribute('data-type');
        const cat = sign.getAttribute('data-category');

        const matchQuery = query === '' || name.includes(query) || code.includes(query);
        const matchFilter = activeFilter === 'all' || type === activeFilter;
        const matchCat = activeCat === 'all' || cat === activeCat;

        if (matchQuery && matchFilter && matchCat) {
          sign.style.display = 'block';
          count++;
        } else {
          sign.style.display = 'none';
        }
      });

      noResults.style.display = count === 0 ? 'block' : 'none';
    }

    // Hodisalar
    searchInput.addEventListener('input', filterSigns);
    searchBtn.addEventListener('click', filterSigns);
    searchInput.addEventListener('keyup', e => e.key === 'Enter' && filterSigns());

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterSigns();
      });
    });

    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        filterSigns();
      });
    });
  </script>

